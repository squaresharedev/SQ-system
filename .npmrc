# Route the @squaresharedev scope to GitHub Packages (publish + install).
# Auth is NOT stored here: locally, put the token in your user ~/.npmrc
# (see README "Consuming the packages"); in CI, actions/setup-node writes it.
@squaresharedev:registry=https://npm.pkg.github.com

# Build-time needs are declared explicitly as devDependencies; don't
# auto-install peers (it would pull all of `next` into @squaresharedev/db,
# which types next/headers via a local ambient shim instead).
auto-install-peers=false
